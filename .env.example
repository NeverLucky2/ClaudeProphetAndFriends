# Alpaca API Configuration
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_PUBLIC_KEY=your_alpaca_public_key
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Shared Alpaca data-API rate cap (requests/min) for bar + options-chain fetches.
# Default 180 (headroom under the Basic plan's 200/min). Raise on Algo Trader Plus.
# Set to 0 to disable the cap.
ALPACA_DATA_RATE_PER_MIN=180

# Shared cross-agent daily-bar cache (>=1Day bars only). Default on; it is a
# soft-failing read optimization. Dir must resolve to the SAME absolute path for
# every bot (they share cwd); the bot logs the resolved absolute path at startup.
BAR_CACHE_ENABLED=true
BAR_CACHE_DIR=./data/bar-cache
BAR_CACHE_TTL=5m

# Candidate-cache warmer gating. Set automatically per-agent by the orchestrator
# from strategyId (Coil -> meanrev, Drift -> drift); listed here for reference.
# Do not set these to true globally — that would re-enable the redundant sweeps.
# ENABLE_MEANREV_WARMER=false
# ENABLE_DRIFT_WARMER=false

# AI provider for news cleaning (optional)
# AI_PROVIDER=claude   # "claude" or "xai" — auto-detected from whichever key is set if omitted
CLAUDE_API_KEY=your_claude_api_key
XAI_API_KEY=your_xai_api_key

# FMP API key
FMP_API_KEY=your_fmp_api_key

# Email for PennyProphet
OPERATOR_EMAIL=your@email.com

# PENNY_MAX_FILTER_MODE = "shadow" as default, only documents intent. set to "enforce" change code to threshold

# Financial Modeling Prep API key (required for PennyProphet universe screening)
FMP_API_KEY=your_fmp_api_key

OPERATOR_EMAIL=your_penny_agent_email

# --- Capital allocation (reconciled 2026-05-25; lanes sum to 100%) ---
# Spark/Penny segment cap — the ONLY code-enforced sleeve cap (services/trade_guard.go).
# Reconciled lanes: Prophet 34 / Coil 18 / Turtle 14 / Drift 12 / Spark 12 / Harvest 10.
# Was effectively 0.20 (code default, despite rules saying 30%); now pinned to 0.12.
PENNY_MAX_CAPITAL_PCT=0.12

# Reddit OAuth (script app) for PennyProphet social signals.
# Create a "script" app at https://www.reddit.com/prefs/apps using a dedicated bot account.
# When all four are set, social_signal_service polls oauth.reddit.com with bearer-token
# auth (~60 req/min). When any is missing, Reddit polls are skipped (StockTwits still runs).
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USERNAME=your_bot_account_username
# REDDIT_PASSWORD=your_bot_account_password
# REDDIT_USER_AGENT=                       # optional override; defaults to "go:prophet-penny-bot:1.0 (by /u/<username>)"

# --- Prophet downside backstops (enabled 2026-05-25; regime gate intentionally left OFF) ---
# Bound disasters/slippage WITHOUT limiting Prophet's upside discretion.
# universe gate: reject options opens off the liquid floor (config/prophet_tradable_universe.txt, 43 names)
ENABLE_PROPHET_UNIVERSE_GATE=true
# spread gate: reject options opens with (ask-bid)/mid >= 10% or stale/missing quote
ENABLE_PROPHET_OPTIONS_SPREAD=true
# options stop: Go monitor flattens long single-leg options past -50% of premium (overnight-gap backstop)
ENABLE_PROPHET_OPTIONS_STOP=true

# Agent Dashboard Configuration (optional)
AGENT_PORT=3737                        # Dashboard port (default: 3737)
AGENT_AUTH_TOKEN=                       # Set a token to require auth on all API routes
TRADING_BOT_PORT=4534                   # Go backend port (default: 4534)
TRADING_BOT_URL=http://localhost:4534   # Go backend URL (default: auto from port)

# ── Cross-agent risk controls (Items 1 + 2 of the risk-and-diversification plan)
# Both default OFF. The infrastructure runs in observation mode while these are
# unset/false — guard/status and regime-gate/status payloads still report
# exposures and tier, but agents see neutral output (no rejections, no sizing
# throttle, no entry block). Flip to true only after the 2-week calibration
# window described in docs/superpowers/plans/2026-05-14-risk-and-diversification-plan.md.
# ENABLE_SECTOR_AGGREGATION=false          # TradeGuard cross-agent sector-bucket cap
# SECTOR_DEFAULT_MAX_PCT=0.15              # Fallback cap for buckets without an explicit override
# ENABLE_REGIME_GATE=false                 # Daily regime-tier sizing throttle + RED-tier entry block
# REGIME_REPORT_PATH=./data/reports/regime_gate.json   # Written daily by scripts/compute_daily_regime_score.py

# Second Alpaca account (optional — auto-creates a second sandbox on startup if not already present)
# ALPACA_NAME_2=Account 2
# ALPACA_PUBLIC_KEY_2=your_second_public_key
# ALPACA_SECRET_KEY_2=your_second_secret_key
# ALPACA_ENDPOINT_2=https://paper-api.alpaca.markets
# ALPACA_PAPER_2=true

# Beat-context bundle injection — default on. Set to exactly the string "false"
# to disable (any other value, including unset, leaves it enabled). Use this
# to isolate an LLM behavior regression to the bundle without redeploying.
BEAT_CONTEXT_ENABLED=true

# Harvest exit monitor — long-term target is on (set below). The Go
# background service handles Step 2 exits (DTE<=21, 2x credit loss stop,
# 0.5x credit profit target) and the harvest preflight skips the LLM
# beat when only exits would have woken it. Must be exactly the string
# "true" to enable — any other value (including unset) disables and
# returns Harvest exits to the LLM. New deployments should smoke-test
# against one paper condor before trusting it with multiple positions —
# see Task 8 of docs/superpowers/plans/2026-05-16-harvest-exit-monitor.md.
HARVEST_EXIT_MONITOR_ENABLED=true

# Turtle (TrendProphet) Go scheduler — default OFF. When set to exactly the
# string "true", the daily 17:00 ET weekday TRADING_RULES_TREND.md heartbeat
# runs in services/turtle_scheduler.go instead of the LLM, and the trend
# preflight (agent/preflight.js trendPreflight) skips every beat via
# /api/v1/turtle/status. The LLM is retained only for the quarterly
# trend_parameter_review skill (operator-triggered). Any other value
# (including unset) leaves the trend agent's LLM beat as today's authority.
# Run for at least three weekday cycles before considering this battle-tested
# — trend signals only fire on EOD bars, so any bug in the signal-to-action
# chain may only surface on the day a real breakout happens. See
# docs/superpowers/plans/2026-05-16-turtle-go-scheduler.md for the full plan.
TURTLE_SCHEDULER_ENABLED=false

# Prophet options auto-stop monitor — default OFF. When set to exactly the
# string "true", a Go background service (services/prophet_options_stop_monitor.go)
# polls Prophet's (v2-options) LONG single-leg options positions every minute
# during market hours and flattens any past a deep catastrophic loss floor
# (PROPHET_OPTIONS_STOP_PCT, default -50% since entry). This is a backstop far
# below the LLM's ~-15% discretionary stop — it exists for overnight gap-downs
# the ~8h heartbeat can't catch at the open. It defers to the LLM (a
# beats-observed startup grace + a per-symbol cool-off after any LLM order) and
# never touches a Harvest condor leg. Any value other than "true" (including
# unset) disables it. NOTE: there is NO dry-run mode — "true" means it places
# real (paper) flatten orders, not just logs. Smoke-test on paper and watch the
# prophet_options_stop_* logs before trusting it. See
# docs/superpowers/specs/2026-05-21-prophet-options-auto-stop-monitor-design.md.
ENABLE_PROPHET_OPTIONS_STOP=false

# Optional tuning for the monitor above (shown with their built-in defaults —
# uncomment only to override; the monitor works without these set):
# PROPHET_OPTIONS_STOP_PCT=0.50              # loss floor as a fraction of premium, since entry
# PROPHET_OPTIONS_STOP_COOLOFF_MIN=7         # suppress a flatten for N min after any LLM order on the symbol
# PROPHET_OPTIONS_STOP_ESCALATION_SEC=60     # wait before escalating rung-0 (limit at bid) -> rung-1 (wide limit)
# PROPHET_OPTIONS_STOP_SANITY_FLOOR_FRAC=0.50  # terminal limit never below this fraction of the fresh mid (anti-phantom-print)

# ── Prophet tradable-universe boundary + options spread gate ────────────────
# Both gates default OFF and apply ONLY to Prophet (v2-options) options OPENS
# (never a close). Full design:
# docs/superpowers/specs/2026-05-24-prophet-tradable-universe-and-spread-gate-design.md
#
# Universe gate: when "true", the TradeGuard rejects an options open whose
# underlying is not in the tradable floor file below. Fails OPEN (never blocks)
# if the floor file is missing or empty — a missing config is "not configured
# yet", not a reason to halt trading.
ENABLE_PROPHET_UNIVERSE_GATE=false
PROPHET_TRADABLE_UNIVERSE_PATH=./config/prophet_tradable_universe.txt
#
# Spread gate: when "true", rejects an options open whose (ask-bid)/mid is at or
# above PROPHET_OPTIONS_SPREAD_MAX_PCT, OR whose Alpaca options-snapshot quote is
# missing / stale / crossed (fail CLOSED — a missing runtime quote means "can't
# verify liquidity right now"). Quote-unavailable and wide-spread rejections log
# distinct reasons (guard_options_quote_unavailable vs guard_options_spread_exceeded).
ENABLE_PROPHET_OPTIONS_SPREAD=false
# PROPHET_OPTIONS_SPREAD_MAX_PCT=0.10        # reject spreads >= 10% of mid (default)
#
# Quote staleness bound, in WHOLE SECONDS — a bare integer. Do NOT append "s":
# "1020s" fails to parse and SILENTLY falls back to the default 60. A quote older
# than this fails closed; the value is hard-capped at 1020s in code regardless.
# The default 60 assumes a REAL-TIME options feed. On Alpaca's free/Basic feed
# (15-min delayed OPRA) leaving it at 60 would reject every quote — set 1020 there.
# Observe your feed's actual quote age BEFORE enabling the spread gate, then set
# to match: real-time -> ~30, delayed -> 1020.
# PROPHET_OPTIONS_QUOTE_MAX_AGE_SEC=60
